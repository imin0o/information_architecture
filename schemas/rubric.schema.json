{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric.schema.json",
  "title": "内容評価ルーブリック tests/cases/rubric.yaml（10章、AC-09）",
  "description": "人が同じ条件で内容評価するための固定基準。LLMの自己評価やスキーマ検証だけで合格にしない",
  "type": "object",
  "required": ["schema_version", "rubric_version", "pass_rule", "severity", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "rubric_version": {"$ref": "common.schema.json#/$defs/version"},
    "pass_rule": {"$ref": "common.schema.json#/$defs/nonempty"},
    "input_gaps": {"description": "入力の不足を成果物の不備と区別する規則", "$ref": "common.schema.json#/$defs/nonempty"},
    "changes": {"$ref": "case.schema.json#/properties/changes"},
    "severity": {
      "type": "object", "required": ["critical", "major", "minor"], "additionalProperties": false,
      "properties": {"critical": {"$ref": "common.schema.json#/$defs/nonempty"},
                     "major": {"$ref": "common.schema.json#/$defs/nonempty"},
                     "minor": {"$ref": "common.schema.json#/$defs/nonempty"}}
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["item", "name", "pass_criteria", "fail_examples"], "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "pattern": "^R-[0-9]{2}$"},
          "name": {"$ref": "common.schema.json#/$defs/nonempty"},
          "pass_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}},
          "fail_examples": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonempty"}}
        }
      }
    }
  }
}
