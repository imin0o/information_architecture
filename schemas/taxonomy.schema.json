{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "分類体系 taxonomy.yaml（FR-02）",
  "description": "体系（ファセット等）は語彙の概念IDで構成し、コンテンツを概念IDで分類する",
  "type": "object",
  "allOf": [{"$ref": "common.schema.json#/$defs/header"}],
  "required": ["vocabulary", "inventory", "schemes", "assignments"],
  "unevaluatedProperties": false,
  "properties": {
    "vocabulary": {"$ref": "common.schema.json#/$defs/artifact_ref"},
    "inventory": {"$ref": "common.schema.json#/$defs/artifact_ref"},
    "schemes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["scheme_id", "label", "kind", "top_concepts", "decision_ref"],
        "additionalProperties": false,
        "properties": {
          "scheme_id": {"$ref": "common.schema.json#/$defs/scheme_id"},
          "label": {"$ref": "common.schema.json#/$defs/nonempty"},
          "kind": {"enum": ["facet", "hierarchy", "list"]},
          "top_concepts": {"type": "array", "minItems": 1, "uniqueItems": true,
                           "items": {"$ref": "common.schema.json#/$defs/concept_id"}},
          "decision_ref": {"$ref": "run.schema.json#/$defs/decision_ref"}
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object", "required": ["content_id", "concept_ids"], "additionalProperties": false,
        "properties": {
          "content_id": {"$ref": "common.schema.json#/$defs/content_id"},
          "concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
                          "items": {"$ref": "common.schema.json#/$defs/concept_id"}}
        }
      }
    }
  }
}
