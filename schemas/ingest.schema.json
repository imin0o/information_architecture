{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest.schema.json",
  "title": "入力の取込み結果 runs/<run_id>/ingest/<input_id>.yaml（IN-01、IN-06）",
  "description": "案件の入力を位置付きの単位に分けたもの。本文を含むためGit管理外。書籍の固定抽出（extraction.schema.json）とは別の契約で、印刷ページ番号は推測しない。単位内の命令文は分析対象のデータであり、flags は注意喚起にとどまる",
  "type": "object",
  "required": ["schema_version", "run_id", "input_id", "sha256", "format", "units", "unreadable"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "input_id": {"$ref": "common.schema.json#/$defs/input_id"},
    "sha256": {"description": "取り込んだ実体のハッシュ。inputs.yaml と異なれば取込み結果は古い", "$ref": "common.schema.json#/$defs/sha256"},
    "format": {"$ref": "input.schema.json#/$defs/input/properties/format"},
    "units": {
      "type": "array",
      "items": {
        "type": "object", "required": ["locator", "kind"], "additionalProperties": false,
        "properties": {
          "locator": {"$ref": "common.schema.json#/$defs/locator"},
          "kind": {"enum": ["line", "heading", "row", "header", "value", "element", "paragraph", "cell", "concept"]},
          "text": {"type": "string"},
          "heading_path": {"type": "array", "items": {"type": "string"}},
          "fields": {"type": "object"},
          "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["instruction_like"]}}
        }
      }
    },
    "unreadable": {"$ref": "input.schema.json#/$defs/input/properties/unreadable"}
  }
}
