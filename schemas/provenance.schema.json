{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "根拠抜粋の登録簿 library/provenance.yaml（付録B.1）",
  "description": "抜粋全文は複製しない。extracted_refはローカル照合用の位置であり、配布物内のファイルリンクではない",
  "type": "object",
  "required": ["schema_version", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["evidence_id", "source_id", "source_sha256", "extracted_sha256", "extracted_ref", "locator",
                   "excerpt_sha256", "excerpt_preview", "support_reviews"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"$ref": "common.schema.json#/$defs/evidence_id"},
        "source_id": {"$ref": "common.schema.json#/$defs/source_id"},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "extracted_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "extracted_ref": {
          "type": "object", "required": ["extraction_id", "start_line", "end_line"], "additionalProperties": false,
          "properties": {
            "extraction_id": {"$ref": "common.schema.json#/$defs/extraction_id"},
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"description": "両端を含む", "type": "integer", "minimum": 1}
          }
        },
        "locator": {
          "description": "原典との対応を確認できた項目だけを記入する。未確認はnullまたは空配列",
          "type": "object",
          "required": ["chapter", "section", "pdf_page_indices", "printed_page_labels", "epub_href", "element_id"],
          "additionalProperties": false,
          "properties": {
            "chapter": {"type": ["string", "null"]},
            "section": {"type": ["string", "null"]},
            "pdf_page_indices": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
            "printed_page_labels": {"type": "array", "items": {"type": "string"}},
            "epub_href": {"type": ["string", "null"]},
            "element_id": {"type": ["string", "null"]}
          }
        },
        "excerpt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "excerpt_preview": {"description": "範囲の先頭からの連続部分。英語25語以内", "type": "string", "minLength": 1},
        "support_reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}}
      }
    },
    "review": {
      "type": "object",
      "required": ["claim_id", "claim", "claim_sha256", "applicability", "status", "reviewed_by", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"$ref": "common.schema.json#/$defs/claim_id"},
        "claim": {"$ref": "common.schema.json#/$defs/nonempty"},
        "claim_sha256": {"description": "claimのUTF-8バイト列のハッシュ", "$ref": "common.schema.json#/$defs/sha256"},
        "applicability": {"$ref": "common.schema.json#/$defs/nonempty"},
        "status": {"enum": ["supported", "not_supported", "unclear", "unreviewed"]},
        "reviewed_by": {"oneOf": [{"$ref": "common.schema.json#/$defs/person"}, {"type": "null"}]},
        "reviewed_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/datetime"}, {"type": "null"}]}
      },
      "if": {"properties": {"status": {"const": "unreviewed"}}},
      "then": {"properties": {"reviewed_by": {"type": "null"}, "reviewed_at": {"type": "null"}}},
      "else": {"properties": {"reviewed_by": {"type": "string"}, "reviewed_at": {"type": "string"}}}
    }
  }
}
