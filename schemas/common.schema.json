{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "共通データ契約の部品（4.4）",
  "description": "他のスキーマから相対$refで参照する。単体では検証対象にしない",
  "$defs": {
    "schema_version": {"const": "1.0"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "datetime": {"type": "string", "format": "date-time"},
    "nonempty": {"type": "string", "pattern": "\\S"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "person": {"description": "確認・承認した人。エージェントの自己申告には使わない", "type": "string", "pattern": "\\S"},
    "source_id": {"type": "string", "pattern": "^(BOOK-[0-9]{3}|FIXTURE-[a-z0-9-]+)$"},
    "evidence_id": {"type": "string", "pattern": "^EV-[0-9]{4}$"},
    "claim_id": {"type": "string", "pattern": "^CLAIM-[0-9]{4}$"},
    "extraction_id": {"type": "string", "pattern": "^EXTRACT-[A-Z0-9]+-[0-9]{3}$"},
    "receipt_id": {"type": "string", "pattern": "^VR-[0-9]{4}$"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9A-Za-z-]+$"},
    "input_id": {"type": "string", "pattern": "^INPUT-[0-9]{3}$"},
    "observation_id": {"type": "string", "pattern": "^OBS-[0-9]{3}$"},
    "study_id": {"type": "string", "pattern": "^STUDY-[0-9]{3}$"},
    "decision_id": {"type": "string", "pattern": "^IA-[0-9]{3}$"},
    "artifact_id": {"type": "string", "pattern": "^ART-[0-9]{3}$"},
    "content_id": {"type": "string", "pattern": "^CONTENT-[0-9]{3}$"},
    "concept_id": {"type": "string", "pattern": "^CONCEPT-[0-9]{3}$"},
    "node_id": {"type": "string", "pattern": "^NODE-[0-9]{3}$"},
    "scheme_id": {"type": "string", "pattern": "^SCHEME-[0-9]{3}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{2}$"},
    "approval_id": {"type": "string", "pattern": "^APPROVAL-[0-9]{3}$"},
    "classification": {
      "description": "機密区分（IN-02、IN-05）。public < internal < confidential",
      "enum": ["public", "internal", "confidential"]
    },
    "locator": {"description": "入力内の参照位置（例: pages.csv#row=2）", "type": "string", "pattern": "\\S"},
    "artifact_ref": {
      "type": "object", "required": ["artifact_id", "version"], "additionalProperties": false,
      "properties": {"artifact_id": {"$ref": "#/$defs/artifact_id"}, "version": {"type": "integer", "minimum": 1}}
    },
    "header": {
      "description": "成果物の共通見出し。版と機密区分を持つ",
      "type": "object",
      "required": ["schema_version", "run_id", "artifact_id", "version", "classification"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "run_id": {"$ref": "#/$defs/run_id"},
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "version": {"type": "integer", "minimum": 1},
        "classification": {"$ref": "#/$defs/classification"}
      }
    }
  }
}
