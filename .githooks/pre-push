#!/bin/sh
# stdin contains refs proposed for this push. Keep it for iakit leaks check, which runs first.
refs=$(cat)
if ! printf '%s' "$refs" | uv run --locked iakit leaks check --pre-push "$1"; then
  exit 1
fi
# 送信予定の各コミットを一時checkoutで全件検査する。作業ツリーの修正では代用しない。
if ! out=$(printf '%s' "$refs" | uv run --locked iakit check --pre-push 2>&1); then
  printf '%s\n' "$out" >&2
  printf '%s\n' "iakit check --local が失敗したため、送信を中止しました。配布の不一致なら iakit dist build で再生成してください。" >&2
  exit 1
fi
